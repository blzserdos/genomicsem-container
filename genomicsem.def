Bootstrap: docker
From: rocker/r-ver:4.5.3

%labels
    Version      1.1.0
    R.version    4.5.3
    GenomicSEM   0.0.5 (GitHub commit da95d431a4709693d07eae55e172ade55526948b)
    lavaan       0.7-3 (pinned)
    Description  R 4.5.3 with GenomicSEM 0.0.5, lavaan 0.7-3, psych, GPArotation, data.table, Matrix, gdata

%post
    # ── System dependencies ────────────────────────────────────────────────
    apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        libcurl4-openssl-dev \
        libssl-dev \
        libxml2-dev \
        libgit2-dev \
        zlib1g-dev \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    # ── R packages ────────────────────────────────────────────────────────
    # Dated Posit Package Manager snapshot (Linux binaries for this image's
    # Ubuntu release), so a rebuild gives the same package versions.
    CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")
    export CRAN_SNAPSHOT="https://packagemanager.posit.co/cran/__linux__/${CODENAME}/2026-10-15"
    Rscript -e "
      options(repos = c(CRAN = Sys.getenv('CRAN_SNAPSHOT')))
      install.packages(c('remotes', 'data.table', 'Matrix', 'psych',
                         'GPArotation', 'gdata'),
                       Ncpus = parallel::detectCores())
      # lavaan pinned explicitly. GenomicSEM needs commit bba1042 (2026-09-28)
      # or later to work with lavaan 0.7.x (ordered = FALSE in its DWLS calls)
      remotes::install_version('lavaan', version = '0.7-3', upgrade = 'never',
                               repos = 'https://packagemanager.posit.co/cran/2026-10-15')
      # Pinned commit: code that patches or reproduces GenomicSEM internals
      # (e.g. ldsc(), usermodel()) is validated against this exact version
      remotes::install_github('GenomicSEM/GenomicSEM@da95d431a4709693d07eae55e172ade55526948b',
                              upgrade = 'never', Ncpus = parallel::detectCores())
    "

    # ── Verify installations ──────────────────────────────────────────────
    Rscript -e "
      pkgs <- c('GenomicSEM', 'lavaan', 'psych', 'GPArotation', 'data.table', 'Matrix', 'gdata')
      ok   <- sapply(pkgs, requireNamespace, quietly = TRUE)
      if (!all(ok)) stop('Missing packages: ', paste(pkgs[!ok], collapse = ', '))
      stopifnot(packageVersion('GenomicSEM') == '0.0.5', packageVersion('lavaan') == '0.7.3')
      for (p in pkgs) cat(p, as.character(packageVersion(p)), '\n')
      cat(R.version.string, '\n')
    "

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

%runscript
    exec Rscript "$@"

%help
    R 4.5.3 with GenomicSEM 0.0.5 (GitHub commit da95d43), lavaan 0.7-3,
    psych, GPArotation, data.table, Matrix and gdata.

    Usage (bind the directories your scripts and data live in):
      apptainer run --bind /path/to/project genomicsem.sif my_script.R
      apptainer exec genomicsem.sif Rscript -e "library(GenomicSEM); sessionInfo()"
      apptainer shell genomicsem.sif
